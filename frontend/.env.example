# Frontend environment variables (copy to frontend/.env for local overrides)
# Production (e.g. Render Static Site): full backend URL including /api
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
#
# Local development: leave VITE_API_BASE_URL unset; Vite proxies /api to
# VITE_DEV_PROXY_TARGET (default http://localhost:8080).
# VITE_DEV_PROXY_TARGET=http://localhost:8080
